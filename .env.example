# Environment variables for CarePilot AI Backend
# Copy this file to .env and fill in your values

# ─── REQUIRED ─────────────────────────────────────────────────────────────────
# Google AI Studio API key (get one from https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# Use Gemini API (AI Studio) instead of Vertex AI — set to False for AI Studio
GOOGLE_GENAI_USE_VERTEXAI=False

# ─── CORS (REQUIRED FOR PRODUCTION) ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Set this to your Vercel deployment URL after deploying.
# Example: ALLOW_ORIGINS=https://carepilot-ai.vercel.app
# For local development, leave blank (allows all origins)
ALLOW_ORIGINS=

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────
# Google Cloud Storage bucket for storing conversation logs (optional)
LOGS_BUCKET_NAME=

# Google Cloud project and location (only needed for Vertex AI)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
