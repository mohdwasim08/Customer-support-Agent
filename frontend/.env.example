# Frontend Environment Variables
# Copy this file to frontend/.env.production and set VITE_API_URL to your deployed backend URL.

# ─── REQUIRED FOR PRODUCTION ─────────────────────────────────────────────────
# Your deployed backend URL (Railway / Render / Cloud Run).
# Leave blank for local development — the app auto-detects the backend.
# Example: VITE_API_URL=https://carepilot-api.railway.app
VITE_API_URL=

# ─── HOW IT WORKS ────────────────────────────────────────────────────────────
# When VITE_API_URL is set → uses that URL for all API calls.
# When blank on localhost   → uses http://localhost:8080
# When blank on LAN IP      → uses http://<same-ip>:8080
# When blank on tunnel/cloud→ uses window.location.origin (proxy through Vite)
